# =============================================================================
# AEGIS-FIN  —  Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<your-service-role-key>

# ── Store backend ─────────────────────────────────────────────────────────────
# MUST be "supabase" in production (Railway deployment)
# "memory" is only for local dev/testing (data lost on restart)
STORE_BACKEND=supabase

# ── Pipeline schedule ─────────────────────────────────────────────────────────
# UTC time to run the daily pipeline (default: 13:00 UTC = 18:30 IST)
PIPELINE_HOUR_UTC=13
PIPELINE_MIN_UTC=0

# ── Logging ───────────────────────────────────────────────────────────────────
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_FORMAT=text    # text | json
